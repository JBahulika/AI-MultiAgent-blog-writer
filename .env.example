# Public site URL used for same-origin checks in production (optional on Vercel)
NEXT_PUBLIC_APP_URL=

# Server-only secrets (never commit real values)
# Prefer Groq (free tier). Falls back to OpenAI if GROQ_API_KEY is unset.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_STRONG=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o-mini

# Optional — enables live web research for the researcher agent (https://tavily.com)
# Without it, research falls back to the PRD only.
TAVILY_API_KEY=

# Supabase logging
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional durable rate limits (recommended on Vercel). Falls back to in-memory if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: if set, /api/generate requires matching x-api-secret header (server-only; do not expose to the client)
GENERATE_API_SECRET=

# Public Supabase values (only if you use client-side Supabase — Phase 2 run history)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
